# Keep sandbox documentation and templates in Git, but keep external code,
# runtime workspaces, and raw logs local.

inbox/*
!inbox/README.md

sources/*
!sources/README.md

workspaces/*
!workspaces/README.md

runs/*
!runs/README.md

reports/*
!reports/README.md

*.zip
*.tar
*.tar.gz
*.7z
*.rar

drafts/*
!drafts/README.md
