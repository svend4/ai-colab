# Keep sandbox documentation and templates in Git, but keep external code,
# runtime workspaces, and raw logs local.

inbox/*
!inbox/README.md

sources/*
!sources/README.md

workspaces/*
!workspaces/README.md

runs/*
!runs/README.md

reports/*
!reports/README.md

*.zip
*.tar
*.tar.gz
*.7z
*.rar

# External fetched TVCP snapshot: keep only intake manifest in Git until provenance/license snapshot is complete.
tvcp_fetched/*
!tvcp_fetched/README.intake.md

drafts/*
!drafts/README.md

info-drafts/*
!info-drafts/README.md
