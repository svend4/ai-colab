#!/bin/sh
# pre-commit hook: блокирует коммит, если валидатор канона (tools/validate.py) нашёл ERROR.
# WARN (например, кириллические имена по D-007) НЕ блокирует.
#
# Активация один раз (из корня репозитория):
#     git config core.hooksPath tools/githooks
# Разовый пропуск:
#     git commit --no-verify

# Найти РАБОЧИЙ Python 3.
# На Windows 'python3' часто — нерабочий App-Execution-Alias (заглушка Microsoft Store):
# он есть в PATH, но печатает "Python" и падает. Поэтому проверяем, что интерпретатор
# реально запускается и это Python 3, а не просто присутствует в PATH.
# Дополнительно ищем по типовым Windows-путям, если PATH не содержит Python.
PY=""
for cand in python python3 py; do
  if "$cand" -c "import sys; assert sys.version_info[0] >= 3" >/dev/null 2>&1; then
    PY="$cand"
    break
  fi
done

# Fallback: типовые Windows-пути (Git Bash, Python 3.12)
if [ -z "$PY" ]; then
  for cand in \
    "/c/Users/$(whoami)/AppData/Local/Programs/Python/Python312/python.exe" \
    "/c/Users/$(whoami)/AppData/Local/Programs/Python/Python311/python.exe" \
    "/c/Users/$(whoami)/AppData/Local/Programs/Python/Python310/python.exe" \
    "/c/Program Files/Python312/python.exe" \
    "/c/Program Files/Python311/python.exe" \
    "/c/Program Files/Python310/python.exe"; do
    if "$cand" -c "import sys; assert sys.version_info[0] >= 3" >/dev/null 2>&1; then
      PY="$cand"
      break
    fi
  done
fi

if [ -z "$PY" ]; then
  echo "pre-commit: рабочий Python 3 не найден — валидация пропущена."
  echo "Установите Python 3 или добавьте в PATH. Проверка отключена, но НЕ рекомендуется."
  exit 0
fi

"$PY" tools/validate.py || {
  echo ""
  echo "pre-commit: валидатор канона нашёл ошибки (см. выше). Коммит отклонён."
  echo "Исправь их или используй 'git commit --no-verify', если уверен."
  exit 1
}

"$PY" tools/generate.py --check || {
  echo ""
  echo "pre-commit: навигация устарела. Запусти 'python tools/generate.py', добавь изменения (git add) и закоммить снова."
  echo "Или 'git commit --no-verify', если уверен."
  exit 1
}

exit 0
